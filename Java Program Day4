  //-------M pattern----------//
  import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < 2 * n - 1; j++) {

                if (j == 0 || j == 2 * n - 2 ||
                    (j == i && i <= n / 2) ||
                    (j == (2 * n - 2 - i) && i <= n / 2)) {
                    System.out.print("*");
                } else {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
    }
}
