//-----SINGLE INHERITANCE-----
class Parent {
    void show() {
        System.out.println("Parent");
    }
}

class Child extends Parent {
    void display() {
        System.out.println("Child");
    }
}

class Main {
    public static void main(String[] args) {
        Child c = new Child();
        c.show();
        c.display();
    }
}
//-----------------------------------------------------------------------------

//---MULTIPLE INHERTANCE-----
interface A {
    void showA();
}

interface B {
    void showB();
}

class C implements A, B {
    public void showA() {
        System.out.println("A");
    }

    public void showB() {
        System.out.println("B");
    }
}

class Main {
    public static void main(String[] args) {
        C c = new C();
        c.showA();
        c.showB();
    }
}
//----------------------------------------------------------------------------------

//----MILTILEVEL INHERTIANCE------------
  class A {
    void showA() {
        System.out.println("A");
    }
}

class B extends A {
    void showB() {
        System.out.println("B");
    }
}

class C extends B {
    void showC() {
        System.out.println("C");
    }
}

class Main {
    public static void main(String[] args) {
        C c = new C();
        c.showA();
        c.showB();
        c.showC();
    }
}
