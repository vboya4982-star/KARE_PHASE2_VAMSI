//----NESTED CONSTRUCTER------
class Outer {

    class Inner {
        int x;

        Inner(int x) {
            this.x = x;
        }

        void display() {
            System.out.println("x = " + x);
        }
    }

    public static void main(String[] args) {
        Outer obj = new Outer();

        Outer.Inner in = obj.new Inner(10);

        in.display();
    }
}
