//----To Find The Nth Term------
import java.util.*;
class Main 
{
    static int fib(int n)//3
    {
        if(n<=1)//1
        return n;//1
        return fib(n-1)+fib(n-2);
    }
    public static void main(String[] args) {
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int ans = fib(n);//fib(3)
        System.out.println(ans);
    }
}
