//----TO CHECK THE NUMBER POWER OR NOT BY USING FUNCTION Ith ARGUMENT NO RETURN TYPE-------
class Main {

    static void checkPower(int n) {
        int temp = n;

        while (temp > 1 && temp % 2 == 0) {
            temp = temp / 2;
        }

        if (temp == 1)
            System.out.println(n + " is a power of 2");
        else
            System.out.println(n + " is not a power of 2");
    }

    public static void main(String[] args) {
        checkPower(16);
    }
}
