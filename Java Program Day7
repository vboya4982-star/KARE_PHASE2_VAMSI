//----MISSING NUMBER-------------------

import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int sum = 0;

        for (int i = 0; i < n - 1; i++) {
            sum += sc.nextInt();
        }

        int total = n * (n + 1) / 2;
        int missing = total - sum;

        System.out.println(missing);

        sc.close();
    }
}
