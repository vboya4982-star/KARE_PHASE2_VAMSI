import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] nums = new int[n];
        int i;int sum=0;
        int one_count=0,zero_count=0,two_count=0;
        for ( i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
            if(nums[i]==1)
                one_count++;
            else if(nums[i]==0)
                zero_count++;
            else if(nums[i]==2)
                two_count++; 
        }
        for(i=0;i<zero_count;i++)
            nums[i]=0;
        for(i=zero_count;i<zero_count+one_count;i++)
            nums[i]=1;
        for(i=zero_count+one_count;i<n-1;i++)
            nums[i]=2;
        for(i=0;i<n;i++){
            System.out.print(nums[i]+" ");
        }
        
    }
}


